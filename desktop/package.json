{
  "name": "codelet-desktop",
  "productName": "codelet",
  "version": "0.1.2",
  "author": "gjq00",
  "description": "codelet Desktop — Local AI Coding Workbench",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "icons": "python scripts/gen-icons.py",
    "build:backend": "pyinstaller --distpath backend-dist --workpath build/pyi -y scripts/codelet-backend.spec",
    "build:electron": "electron-builder --win dir portable nsis --publish never",
    "dist": "electron-builder --win dir portable nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.gjq00.codelet",
    "productName": "codelet",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "muamuauh",
        "repo": "codelet"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend.js",
      "secrets.js",
      "tray.js",
      "updater.js",
      "splash.html",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/codelet-backend",
        "to": "backend/codelet-backend"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "dir",
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "codelet-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "codelet",
      "include": "scripts/installer.nsh",
      "artifactName": "codelet-Setup-${version}.exe"
    }
  }
}
